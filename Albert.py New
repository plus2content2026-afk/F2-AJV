def insertval(tablewin):
    tablewin.destroy()
    inserttable = ctk.CTkToplevel(app)
    inserttable.title("Create Table")
    inserttable.geometry("950x650")
    inserttable.focus()
    inserttable.lift()

    entry_matrix = {}

    info_label = ctk.CTkLabel(
        inserttable,
        text="Enter the teacher code in each period. A save is blocked if a teacher\n"
             "is already scheduled in another class at the same day/period.",
        font=("Arial", 12)
    )
    info_label.pack(padx=20, pady=(15, 0))

    table_frame = ctk.CTkScrollableFrame(inserttable, height=400)
    table_frame.pack(padx=20, pady=20, fill="both", expand=True)

    day_header = ctk.CTkLabel(table_frame, text="Day", font=("Arial", 13, "bold"), text_color="#1f538d")
    day_header.grid(row=0, column=0, padx=8, pady=8, sticky="w")

    for col_idx, col_name in enumerate(PERIODS, start=1):
        header = ctk.CTkLabel(table_frame, text=col_name, font=("Arial", 13, "bold"), text_color="#1f538d")
        header.grid(row=0, column=col_idx, padx=8, pady=8, sticky="ew")

    # Pre-fill with existing data if this class already has entries saved.
    existing = {}
    try:
        c.execute("USE user1")
        c.execute(f"SELECT * FROM `{code}`")
        cols = [d[0] for d in c.description]
        for row in c.fetchall():
            row_dict = dict(zip(cols, row))
            existing[row_dict["Day"]] = row_dict
    except Exception:
        existing = {}

    for row_idx, day_name in enumerate(DAYS, start=1):
        day_label = ctk.CTkLabel(table_frame, text=day_name, font=("Arial", 12, "bold"))
        day_label.grid(row=row_idx, column=0, padx=8, pady=6, sticky="w")

        entry_matrix[day_name] = []
        for col_idx, period_col in enumerate(PERIODS, start=1):
            entry_field = ctk.CTkEntry(table_frame, placeholder_text="-", width=80)
            if day_name in existing and existing[day_name].get(period_col):
                entry_field.insert(0, existing[day_name][period_col])
            entry_field.grid(row=row_idx, column=col_idx, padx=6, pady=6, sticky="ew")
            entry_matrix[day_name].append(entry_field)

    def show_clash_error(messages):
        err_win = ctk.CTkToplevel(inserttable)
        err_win.title("Cannot Save - Clashes Found")
        err_win.geometry("600x350")
        err_win.transient(inserttable)
        err_win.focus()
        err_win.lift()

        ctk.CTkLabel(
            err_win, text="The following teacher clashes were found:",
            font=("Arial", 15, "bold"), text_color="#e34d4d"
        ).pack(pady=(15, 10), padx=15)

        box = ctk.CTkScrollableFrame(err_win, height=220)
        box.pack(padx=15, pady=5, fill="both", expand=True)
        for msg in messages:
            ctk.CTkLabel(box, text=f"• {msg}", anchor="w", justify="left").pack(fill="x", padx=5, pady=3)

        ctk.CTkButton(err_win, text="Close", command=err_win.destroy).pack(pady=15)

    def handle_save():
        c.execute("USE user1")

        # Collect all non-empty cells the user has just typed.
        new_entries = []  # (day, period_col, teacher_code)
        for day, fields in entry_matrix.items():
            for idx, entry_field in enumerate(fields):
                val = entry_field.get().strip()
                if val:
                    new_entries.append((day, PERIODS[idx], val))

        # Check every entry against every OTHER class's schedule.
        clashes = []
        for day, period_col, tcode in new_entries:
            c.execute(
                "SELECT ClassCode FROM teacher_master "
                "WHERE TeacherCode=%s AND Day=%s AND Period=%s AND ClassCode != %s",
                (tcode, day, period_col, code)
            )
            conflict = c.fetchone()
            if conflict:
                clashes.append(
                    f"Teacher '{tcode}' is already teaching '{conflict[0]}' on {day}, {period_col}"
                )

        if clashes:
            show_clash_error(clashes)
            return

        try:
            c.execute(f"DELETE FROM `{code}`")
            for day in DAYS:
                tasks = [entry_field.get().strip() for entry_field in entry_matrix[day]]
                query = (
                    f"REPLACE INTO `{code}` (Day, P1, P2, P3, P4, P5, P6, P7, P8) "
                    "VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s)"
                )
                c.execute(query, [day] + tasks)

            # Refresh this class's footprint in the global teacher registry.
            c.execute("DELETE FROM teacher_master WHERE ClassCode=%s", (code,))
            for day, period_col, tcode in new_entries:
                c.execute(
                    "REPLACE INTO teacher_master (TeacherCode, Day, Period, ClassCode) "
                    "VALUES (%s, %s, %s, %s)",
                    (tcode, day, period_col, code)
                )

            con.commit()
            print("Weekly Schedule Saved Successfully!")
            inserttable.destroy()
        except Exception as e:
            con.rollback()
            print("Save failed:", e)

    save_btn = ctk.CTkButton(inserttable, text="Save Weekly Schedule", command=handle_save)
    save_btn.pack(pady=(0, 20))


