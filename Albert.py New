def show_class_table(class_code):
    c.execute("USE user1")

    try:
        c.execute(f"SELECT 1 FROM `{class_code}` LIMIT 1")
        has_data = c.fetchone() is not None
    except Exception:
        has_data = False

    if has_data:
        query = f"SELECT * FROM `{class_code}`"
        df = pd.read_sql_query(query, con)

        shtable = ctk.CTkToplevel(app)
        shtable.geometry("950x600")
        shtable.title(f"Weekly Timetable - {class_code}")
        for col_idx, column in enumerate(df.columns):
            header = ctk.CTkLabel(shtable, text=str(column), font=("Consolas", 24, "bold"))
            header.grid(row=0, column=col_idx, padx=15, pady=10, sticky='w')
        for row_idx, row in df.iterrows():
            for col_idx, value in enumerate(row):
                cell = ctk.CTkLabel(shtable, text=str(value), font=("Consolas", 20))
                cell.grid(row=row_idx + 1, column=col_idx, padx=15, pady=5, sticky='w')

    else:
        dialog_box = ctk.CTkToplevel(app)
        dialog_box.geometry("680x200")
        label1 = ctk.CTkLabel(dialog_box, text="TIMETABLE DOESNT EXIST!", font=('Arial', 20), text_color="white")
        label1.grid(row=1, column=1, padx=30, pady=20)

        btn2 = ctk.CTkButton(dialog_box, text="Close", command=dialog_box.destroy)
        btn2.grid(row=2, column=1, padx=10, pady=20)


# ---------------------------------------------------------------------------
# Teacher panel: a teacher can see every class/period they're assigned to
# and move a period to a new day/time, as long as it doesn't create a clash
# for them OR collide with something already in the target class's slot.
# ---------------------------------------------------------------------------
def teacherpage(tcode):
    c.execute("USE user1")

    tp = ctk.CTkToplevel(app)
    tp.title(f"Teacher Panel - {tcode}")
    tp.geometry("750x550")
    tp.transient(app)
    tp.focus()
    tp.lift()

    ctk.CTkLabel(tp, text=f"Schedule for teacher: {tcode}", font=("Arial", 18, "bold")).pack(pady=15)

    list_frame = ctk.CTkScrollableFrame(tp, height=420)
    list_frame.pack(padx=20, pady=10, fill="both", expand=True)

    def refresh_schedule():
        for widget in list_frame.winfo_children():
            widget.destroy()

        c.execute(
            "SELECT Day, Period, ClassCode FROM teacher_master WHERE TeacherCode=%s",
            (tcode,)
        )
        rows = c.fetchall()
        # sort by day order, then period order
        rows.sort(key=lambda r: (DAYS.index(r[0]) if r[0] in DAYS else 99,
                                  PERIODS.index(r[1]) if r[1] in PERIODS else 99))

        if not rows:
            ctk.CTkLabel(list_frame, text="No periods assigned yet.").pack(pady=20)
            return

        header = ctk.CTkFrame(list_frame, fg_color="transparent")
        header.pack(fill="x", pady=(0, 8))
        ctk.CTkLabel(header, text="Day", width=100, font=("Arial", 12, "bold")).pack(side="left", padx=5)
        ctk.CTkLabel(header, text="Period", width=80, font=("Arial", 12, "bold")).pack(side="left", padx=5)
        ctk.CTkLabel(header, text="Class", width=120, font=("Arial", 12, "bold")).pack(side="left", padx=5)

        for day, period, class_code in rows:
            row_frame = ctk.CTkFrame(list_frame, fg_color="transparent")
            row_frame.pack(fill="x", pady=4)
            ctk.CTkLabel(row_frame, text=day, width=100).pack(side="left", padx=5)
            ctk.CTkLabel(row_frame, text=period, width=80).pack(side="left", padx=5)
            ctk.CTkLabel(row_frame, text=class_code, width=120).pack(side="left", padx=5)
            ctk.CTkButton(
                row_frame, text="Change", width=90,
                command=lambda d=day, p=period, cc=class_code: open_change_dialog(d, p, cc)
            ).pack(side="left", padx=10)

    def open_change_dialog(old_day, old_period, class_code):
        dlg = ctk.CTkToplevel(tp)
        dlg.title("Change Period")
        dlg.geometry("420x300")
        dlg.transient(tp)
        dlg.focus()
        dlg.lift()

        ctk.CTkLabel(
            dlg, text=f"Move {tcode}'s {old_period} class ({class_code}) on {old_day}",
            wraplength=380, font=("Arial", 13, "bold")
        ).pack(pady=(20, 15))

        ctk.CTkLabel(dlg, text="New Day").pack()
        day_var = ctk.StringVar(value=old_day)
        day_menu = ctk.CTkOptionMenu(dlg, values=DAYS, variable=day_var)
        day_menu.pack(pady=(0, 10))

        ctk.CTkLabel(dlg, text="New Period").pack()
        period_var = ctk.StringVar(value=old_period)
        period_menu = ctk.CTkOptionMenu(dlg, values=PERIODS, variable=period_var)
        period_menu.pack(pady=(0, 10))

        status_label = ctk.CTkLabel(dlg, text="", text_color="#e34d4d", wraplength=380)
        status_label.pack(pady=5)

        def confirm_change():
            new_day = day_var.get()
            new_period = period_var.get()

            if new_day == old_day and new_period == old_period:
                status_label.configure(text="That's the same slot - nothing to change.")
                return

            c.execute("USE user1")

            # 1) Is this teacher already busy at the new slot (a different class)?
            c.execute(
                "SELECT ClassCode FROM teacher_master "
                "WHERE TeacherCode=%s AND Day=%s AND Period=%s",
                (tcode, new_day, new_period)
            )
            teacher_conflict = c.fetchone()
            if teacher_conflict and teacher_conflict[0] != class_code:
                status_label.configure(
                    text=f"Clash: {tcode} already teaches '{teacher_conflict[0]}' on {new_day} {new_period}."
                )
                return

            # 2) Is the target class's own timetable slot already occupied by
            #    a different teacher at that day/period?
            try:
                c.execute(f"SELECT Day, {new_period} FROM `{class_code}` WHERE Day=%s", (new_day,))
                row = c.fetchone()
                occupied_by = row[1] if row else None
            except Exception:
                occupied_by = None

            if occupied_by and occupied_by != tcode:
                status_label.configure(
                    text=f"Clash: class '{class_code}' already has '{occupied_by}' in {new_period} on {new_day}."
                )
                return

            try:
                # Clear the old slot in the class table.
                c.execute(f"UPDATE `{class_code}` SET {old_period}=%s WHERE Day=%s", ("", old_day))
                # Set the new slot in the class table.
                c.execute(
                    f"INSERT INTO `{class_code}` (Day, {new_period}) VALUES (%s, %s) "
                    f"ON DUPLICATE KEY UPDATE {new_period}=%s",
                    (new_day, tcode, tcode)
                )
                # Move the record in teacher_master.
                c.execute(
                    "DELETE FROM teacher_master WHERE TeacherCode=%s AND Day=%s AND Period=%s",
                    (tcode, old_day, old_period)
                )
                c.execute(
                    "REPLACE INTO teacher_master (TeacherCode, Day, Period, ClassCode) VALUES (%s, %s, %s, %s)",
                    (tcode, new_day, new_period, class_code)
                )
                con.commit()
                print(f"Moved {tcode}'s {class_code} class from {old_day} {old_period} to {new_day} {new_period}.")
                dlg.destroy()
                refresh_schedule()
            except Exception as e:
                con.rollback()
                status_label.configure(text=f"Save failed: {e}")

        ctk.CTkButton(dlg, text="Confirm Change", command=confirm_change).pack(pady=15)

    refresh_schedule()
    ctk.CTkButton(tp, text="Refresh", command=refresh_schedule).pack(pady=10)


init_teacher_master()
welcomepage()
