DAYS = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]
PERIODS = ["P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8"]

# Only letters, numbers and underscores are allowed in a table name.
CODE_PATTERN = re.compile(r"^[A-Za-z0-9_]+$")

# Separator used inside a period cell: "ClassCode:Subject"
CELL_SEP = ":"


def clean_code(raw: str) -> str:
    """Turn user input into a safe MySQL table name, or '' if invalid.

    Used for the TEACHER's own identifying code (the table name) -
    e.g. a teacher's initials. Lower-cased so '10A' and '10a' land on
    the same table.
    """
    candidate = raw.strip().replace(" ", "_").replace("-", "_").lower()
    if not candidate or not CODE_PATTERN.match(candidate):
        return ""
    return candidate


def parse_cell(raw):
    """Parse a period cell of the form 'ClassCode:Subject'.

    Returns (class_code, subject) or None if the cell is empty or
    doesn't follow the expected format. This is what lets us later
    find "every period that belongs to class X", across every
    teacher's table.
    """
    if raw is None:
        return None
    raw = raw.strip()
    if not raw or CELL_SEP not in raw:
        return None
    class_part, _, subject_part = raw.partition(CELL_SEP)
    class_part = class_part.strip()
    subject_part = subject_part.strip()
    if not class_part:
        return None
    return class_part, subject_part


def get_all_teacher_tables():
    """List every table (= every teacher's timetable) in the DB."""
    c.execute("USE user1")
    c.execute(
        "SELECT table_name FROM information_schema.tables "
        "WHERE table_schema = 'user1' ORDER BY table_name"
    )
    return [row[0] for row in c.fetchall()]


def compute_student_schedule(student_class):
    """Scan every teacher's table and pull out only the periods that
    belong to this student's class, building a personalised timetable.

    Returns a DataFrame shaped like the normal grid (Day + P1..P8),
    where each cell is 'Teacher - Subject' for periods this class has
    and empty otherwise. Nothing else from any teacher's table is
    exposed.
    """
    target = student_class.strip().lower()
    grid = {day: {p: [] for p in PERIODS} for day in DAYS}

    for teacher in get_all_teacher_tables():
        try:
            c.execute(f"SELECT * FROM `{teacher}`")
            cols = [d[0] for d in c.description]
            rows = c.fetchall()
        except m.Error:
            continue

        for row in rows:
            row_dict = dict(zip(cols, row))
            day = row_dict.get("Day")
            if day not in grid:
                continue
            for period in PERIODS:
                parsed = parse_cell(row_dict.get(period))
                if not parsed:
                    continue
                class_code, subject = parsed
                if class_code.lower() == target:
                    label = f"{teacher} - {subject}" if subject else teacher
                    grid[day][period].append(label)

    data = {"Day": DAYS}
    for p in PERIODS:
        data[p] = ["; ".join(grid[day][p]) for day in DAYS]
    return pd.DataFrame(data)


def get_other_teacher_slot_map(exclude_teacher):
    """Build {(day, period): {class_code_lower: (teacher, subject)}} across
    every teacher's table except exclude_teacher.

    Used to catch double-bookings: the same class can't be in two places
    at the same day/period, even if two different teachers entered it.
    """
    slot_map = {}
    for teacher in get_all_teacher_tables():
        if teacher == exclude_teacher:
            continue
        try:
            c.execute(f"SELECT * FROM `{teacher}`")
            cols = [d[0] for d in c.description]
            rows = c.fetchall()
        except m.Error:
            continue
        for row in rows:
            row_dict = dict(zip(cols, row))
            day = row_dict.get("Day")
            for period in PERIODS:
                parsed = parse_cell(row_dict.get(period))
                if not parsed:
                    continue
                class_code, subject = parsed
                slot_map.setdefault((day, period), {})[class_code.lower()] = (teacher, subject)
    return slot_map


def get_all_classes():
    """Distinct class codes found across every teacher's table."""
    classes_found = set()
    for teacher in get_all_teacher_tables():
        try:
            c.execute(f"SELECT * FROM `{teacher}`")
            cols = [d[0] for d in c.description]
            rows = c.fetchall()
        except m.Error:
            continue
        for row in rows:
            row_dict = dict(zip(cols, row))
            for period in PERIODS:
                parsed = parse_cell(row_dict.get(period))
                if parsed:
                    classes_found.add(parsed[0])
    return sorted(classes_found, key=str.lower)


def show_message(parent, title, message, is_error=False):
    """A small popup used everywhere instead of print()."""
    win = ctk.CTkToplevel(parent)
    win.title(title)
    win.geometry("440x200")
    win.transient(parent)
    win.grab_set()  # modal - user must dismiss before doing anything else

    color = "#e04b4b" if is_error else "#3fa34d"
    label = ctk.CTkLabel(
        win, text=message, font=("Arial", 15), wraplength=400,
        text_color=color, justify="center"
    )
    label.pack(expand=True, padx=20, pady=(20, 10))

    ok_btn = ctk.CTkButton(win, text="OK", command=win.destroy, width=100)
    ok_btn.pack(pady=(0, 20))

    win.after(10, win.lift)
    win.after(10, win.focus)
    return win


